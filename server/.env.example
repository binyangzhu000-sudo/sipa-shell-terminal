# SIPA Shell Server 环境变量
# 复制此文件为 .env 并填写你的配置

# ─── WebSocket SSH 代理 ───
# 代理监听端口（默认 2222）
WS_PORT=2222

# ─── AI API 服务 ───
# API 监听端口（默认 3001）
API_PORT=3001

# AI 提供商: anthropic | openai （默认 anthropic）
AI_PROVIDER=anthropic

# Anthropic Claude API Key
# 获取地址: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI API Key（备用）
# 获取地址: https://platform.openai.com/
OPENAI_API_KEY=

# ─── 跨域配置 ───
# 生产环境请设置为你的前端域名
# 例如: https://your-sipa-shell.pages.dev
CORS_ORIGIN=*
